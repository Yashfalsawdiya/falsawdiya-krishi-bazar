rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: products
    // Document ID: auto-generated
    // Fields:
    //   - name: string (optional)
    //   - hindiName: string (required)
    //   - category: string (required, enum: seeds, fertilizers, pesticides, fungicides, herbicides, medicines, implements)
    //   - brand: string (required)
    //   - price: number (required, positive)
    //   - hidePrice: boolean (optional)
    //   - unit: string (required)
    //   - image: string (optional, URL or base64)
    //   - description: string (optional)
    //   - crops: list (optional, strings)
    //
    // Collection: cropAdvice
    // Document ID: auto-generated
    // Fields:
    //   - name: string (optional)
    //   - hindiName: string (required)
    //   - image: string (optional, URL)
    //   - stages: list (required, objects)
    //
    // Collection: users
    // Document ID: firebase auth uid
    // Fields:
    //   - uid: string (required, matches doc id)
    //   - email: string (required, email format)
    //   - role: string (required, enum: admin, user)
    //
    // Collection: settings
    // Document: content
    // Fields:
    //   - banners: list (objects)
    //   - videos: list (objects)
    //   - partners: list (objects)
    //   - whatsappSection: object
    //   - contactInfo: object
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.get('email', '') == "yashfalsawdiya36@gmail.com" ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin') || 
         (exists(/databases/$(database)/documents/settings/content) && request.auth.token.get('email', '') in get(/databases/$(database)/documents/settings/content).data.get('adminEmails', [])));
    }

    function isValidEmail(email) {
      return email is string && email.size() > 0 && email.size() < 200;
    }

    function isValidUrl(url) {
      return url is string && (url.size() == 0 || url.matches("^https://.*") || url.matches("^http://.*") || url.matches("^data:image/.*"));
    }

    function isValidImage(img) {
      return img is string || (img is map && img.get('primary', '') is string && img.get('fallback', '') is string);
    }

    // Domain Validators
    
    function isValidProduct(data) {
      return data.hindiName is string && data.hindiName.size() > 0 && data.hindiName.size() < 200 &&
             data.brand is string && data.brand.size() > 0 &&
             data.category is string && data.category.size() > 0 &&
             (!('price' in data) || data.price is number) &&
             (!('unit' in data) || data.unit is string) &&
             (!('hidePrice' in data) || data.hidePrice is bool) &&
             (!('inStock' in data) || data.inStock is bool) &&
             (!('image' in data) || isValidImage(data.image)) &&
             (!('description' in data) || (data.description is string && data.description.size() < 5000)) &&
             (!('crops' in data) || data.crops is list) &&
             (!('variants' in data) || data.variants is list) &&
             (!('dosage' in data) || data.dosage is map);
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 &&
             isValidImage(data.icon) &&
             data.order is number &&
             (!('importantInfo' in data) || data.importantInfo is string) &&
             (!('isInfoEnabled' in data) || data.isInfoEnabled is bool);
    }

    function isValidAgriIssue(data) {
      return data.hindiName is string && data.hindiName.size() > 0 &&
             data.englishName is string && data.englishName.size() > 0 &&
             data.type in ['pest', 'disease', 'deficiency'] &&
             isValidImage(data.image) &&
             (!('description' in data) || data.description is string) &&
             (!('relatedProductIds' in data) || data.relatedProductIds is list);
    }

    function isValidHelpline(data) {
      return data.name is string && data.name.size() > 0 &&
             data.number is string && data.number.size() > 0 &&
             data.category is string && data.category.size() > 0 &&
             (!('description' in data) || data.description is string) &&
             (!('order' in data) || data.order is number);
    }

    function isValidUser(data) {
      return (!('uid' in data) || (data.uid is string && data.uid.size() < 128)) && 
             (!('email' in data) || isValidEmail(data.email)) &&
             (!('role' in data) || data.role in ['admin', 'user']) &&
             (!('isBlocked' in data) || data.isBlocked is bool) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 200)) &&
             (!('geminiApiKey' in data) || (data.geminiApiKey is string && data.geminiApiKey.size() < 500));
    }

    function isValidDeliveryPartner(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 200 &&
             data.vehicleType is string && data.vehicleType.size() > 0 &&
             (!('vehicleNumber' in data) || data.vehicleNumber is string) &&
             (!('isActive' in data) || data.isActive is bool) &&
             (!('availabilityStatus' in data) || data.availabilityStatus in ['available', 'on_delivery', 'off_duty']) &&
             (!('assignedOrdersCount' in data) || data.assignedOrdersCount is number) &&
             (!('completedDeliveriesCount' in data) || data.completedDeliveriesCount is number);
    }

    function isValidAppContent(data) {
      return data.banners is list &&
             data.videos is list &&
             data.partners is list &&
             data.whatsappSection is map &&
             data.whatsappSection.mode in ['direct', 'group'] &&
             data.contactInfo is map &&
             (!('isAppActive' in data) || data.isAppActive is bool) &&
             (!('showBannerText' in data) || data.showBannerText is bool) &&
             (!('apiKeyGuideVideoUrl' in data) || data.apiKeyGuideVideoUrl is string) &&
             (!('offers' in data) || data.offers is map) &&
             (!('festivalOffer' in data) || data.festivalOffer is map);
    }
    
    // ===============================================================
    // Rules
    // ===============================================================

    // Connection Test
    match /_connection_test_/{docId} {
      allow read: if true;
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Publicly readable for the marketplace
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Crop Advice Collection
    match /cropAdvice/{adviceId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users can create their own profile as 'user' unless they are the bootstrap admin
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      // Users can update their own profile but cannot change their role or block status unless they are an admin
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && 
                        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') && 
                        request.resource.data.get('isBlocked', false) == resource.data.get('isBlocked', false)) || 
                    isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId}/{subcollection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && (settingId != 'content' || isValidAppContent(request.resource.data));
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCategory(request.resource.data);
      allow update: if isAdmin() && isValidCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    // Agri Issues (Encyclopedia) Collection
    match /agriIssues/{issueId} {
      allow read: if true;
      allow create: if isAdmin() && isValidAgriIssue(request.resource.data);
      allow update: if isAdmin() && isValidAgriIssue(request.resource.data);
      allow delete: if isAdmin();
    }

    // Helplines Collection
    match /helplines/{helplineId} {
      allow read: if true;
      allow create: if isAdmin() && isValidHelpline(request.resource.data);
      allow update: if isAdmin() && isValidHelpline(request.resource.data);
      allow delete: if isAdmin();
    }

    // Orders Collection (For ecommerce orders & tracking)
    match /orders/{orderId} {
      // Users can read their own orders or guest orders by ID, Admin & Delivery partners can read orders
      allow read: if true;
      // Any authenticated user or guest can create an order with valid data
      allow create: if request.resource.data.orderNumber is string &&
                       request.resource.data.items is list &&
                       request.resource.data.totalAmount is number;
      // Admin, order owner, or assigned delivery partner can update order
      allow update: if isAdmin() || 
                       (isAuthenticated() && resource.data.userId == request.auth.uid) ||
                       (isAuthenticated() && resource.data.assignedPartnerEmail == request.auth.token.get('email', ''));
      allow delete: if isAdmin();
    }

    // Delivery Partners Collection
    match /deliveryPartners/{partnerId} {
      allow read: if true;
      allow create: if isAdmin() && isValidDeliveryPartner(request.resource.data);
      allow update: if (isAdmin() && isValidDeliveryPartner(request.resource.data)) ||
                       (isAuthenticated() && resource.data.email == request.auth.token.get('email', '') && isValidDeliveryPartner(request.resource.data));
      allow delete: if isAdmin();
    }

    // Agri Trade Notices Collection
    match /agri_trade_notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Default deny-all (moved to end)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
