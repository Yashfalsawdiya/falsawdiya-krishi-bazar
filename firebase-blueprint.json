{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Agricultural inputs like seeds, fertilizers, etc.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "hindiName": { "type": "string" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "image": { "oneOf": [{ "type": "string" }, { "$ref": "ImageSource" }] },
        "description": { "type": "string" },
        "crops": { "type": "array", "items": { "type": "string" } },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "quantity": { "type": "string" },
              "price": { "type": "number" }
            }
          }
        },
        "dosage": {
          "type": "object",
          "properties": {
            "show": { "type": "boolean" },
            "value": { "type": "string" }
          }
        },
        "inStock": { "type": "boolean" }
      },
      "required": ["hindiName", "category", "brand"]
    },
    "CropAdvice": {
      "title": "CropAdvice",
      "description": "Advice for specific crops at different stages.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "hindiName": { "type": "string" },
        "image": { "type": "string" },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": { "type": "string" },
              "hindiStage": { "type": "string" },
              "advice": { "type": "string" },
              "products": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "User": {
      "title": "User",
      "description": "Application users and their roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "isBlocked": { "type": "boolean" },
        "geminiApiKey": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "SavedProduct": {
      "title": "SavedProduct",
      "description": "Information about a product saved by the user.",
      "type": "object",
      "properties": {
        "productName": { "type": "string" },
        "companyName": { "type": "string" },
        "technicalName": { "type": "string" },
        "category": { "type": "string" },
        "formulation": { "type": "string" },
        "activeIngredient": { "type": "string" },
        "modeOfAction": { "type": "string" },
        "fracIracHracGroup": { "type": "string" },
        "targetCrops": { "type": "string" },
        "targetPests": { "type": "string" },
        "benefits": { "type": "string" },
        "usage": { "type": "string" },
        "features": { "type": "string" },
        "compatibleProducts": { "type": "string" },
        "incompatibleProducts": { "type": "string" },
        "toxicity": { "type": "string" },
        "waitingPeriod": { "type": "string" },
        "phi": { "type": "string" },
        "rei": { "type": "string" },
        "safetyInstructions": { "type": "string" },
        "mixingOrder": { "type": "string" },
        "sprayTiming": { "type": "string" },
        "rainfastPeriod": { "type": "string" },
        "storage": { "type": "string" },
        "hasExactMatch": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["productName", "category", "order"]
    },
    "ImageSource": {
      "title": "ImageSource",
      "description": "Dual source image with primary and fallback URLs.",
      "type": "object",
      "properties": {
        "primary": { "type": "string" },
        "fallback": { "type": "string" }
      }
    },
    "AppContent": {
      "title": "AppContent",
      "description": "Global application content like banners and videos.",
      "type": "object",
      "properties": {
        "branding": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "tagline": { "type": "string" },
            "logo": { "oneOf": [{ "type": "string" }, { "$ref": "ImageSource" }] },
            "pwaIcon": { "oneOf": [{ "type": "string" }, { "$ref": "ImageSource" }] },
            "androidIcon": { "oneOf": [{ "type": "string" }, { "$ref": "ImageSource" }] },
            "splashLogo": { "oneOf": [{ "type": "string" }, { "$ref": "ImageSource" }] }
          }
        },
        "banners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "image": { "oneOf": [{ "type": "string" }, { "$ref": "ImageSource" }] },
              "title": { "type": "string" },
              "subtitle": { "type": "string" }
            }
          }
        },
        "showBannerText": { "type": "boolean", "description": "Toggle to show or hide the title and subtitle on hero banners." },
        "videos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "videoId": { "type": "string" },
              "thumbnail": { "oneOf": [{ "type": "string" }, { "$ref": "ImageSource" }] }
            }
          }
        },
        "partners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "logo": { "oneOf": [{ "type": "string" }, { "$ref": "ImageSource" }] }
            }
          }
        },
        "whatsappSection": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "mode": { "type": "string", "enum": ["direct", "group"] },
            "groupLink": { "type": "string" }
          }
        },
        "contactInfo": {
          "type": "object",
          "properties": {
            "whatsapp": { "type": "string" },
            "address": { "type": "string" }
          }
        },
        "apiKeyGuideVideoUrl": { "type": "string" },
        "festivalOffer": {
          "type": "object",
          "properties": {
            "show": { "type": "boolean" },
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "image": { "oneOf": [{ "type": "string" }, { "$ref": "ImageSource" }] },
            "theme": { "type": "string" }
          }
        }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Product categories.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "icon": { "oneOf": [{ "type": "string" }, { "$ref": "ImageSource" }] },
        "order": { "type": "number" },
        "importantInfo": { "type": "string", "description": "Category-specific important information, disclaimer or announcements." },
        "isInfoEnabled": { "type": "boolean", "description": "Toggle to show or hide the category-specific important information." }
      },
      "required": ["name", "icon", "order"]
    },
    "AgriIssue": {
      "title": "AgriIssue",
      "description": "Encyclopedia of pests, diseases, and nutrient deficiencies.",
      "type": "object",
      "properties": {
        "hindiName": { "type": "string" },
        "englishName": { "type": "string" },
        "type": { "type": "string", "enum": ["pest", "disease", "deficiency"] },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "relatedProductIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["hindiName", "englishName", "type", "image"]
    },
    "Helpline": {
      "title": "Helpline",
      "description": "Helpline numbers for farmers.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "number": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "number", "category"]
    },
    "AgriTradeNotice": {
      "title": "AgriTradeNotice",
      "description": "Government trade notices and advisories.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "department": { "type": "string" },
        "state": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "fullContent": { "type": "string" },
        "orderNumber": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "source": { "type": "string" },
        "isImportant": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "category", "summary"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of agricultural products."
    },
    "/cropAdvice/{adviceId}": {
      "schema": "CropAdvice",
      "description": "Collection of crop-wise advice."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and permissions."
    },
    "/users/{userId}/savedProducts/{savedProductId}": {
      "schema": "SavedProduct",
      "description": "Collection of search results saved by the user."
    },
    "/settings/content": {
      "schema": "AppContent",
      "description": "Global application content settings."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of product categories."
    },
    "/agriIssues/{issueId}": {
      "schema": "AgriIssue",
      "description": "Collection of pests, diseases, and nutrient deficiencies."
    },
    "/helplines/{helplineId}": {
      "schema": "Helpline",
      "description": "Collection of helpline numbers."
    },
    "/agri_trade_notices/{noticeId}": {
      "schema": "AgriTradeNotice",
      "description": "Collection of official trade notices and regulatory updates."
    }
  }
}
