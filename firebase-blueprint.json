{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Agricultural inputs like seeds, fertilizers, etc.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "hindiName": { "type": "string" },
        "category": { "type": "string", "enum": ["seeds", "fertilizers", "pesticides", "fungicides", "herbicides", "medicines", "implements"] },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "crops": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["hindiName", "category", "price", "unit"]
    },
    "CropAdvice": {
      "title": "CropAdvice",
      "description": "Advice for specific crops at different stages.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "hindiName": { "type": "string" },
        "image": { "type": "string" },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": { "type": "string" },
              "hindiStage": { "type": "string" },
              "advice": { "type": "string" },
              "products": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "User": {
      "title": "User",
      "description": "Application users and their roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "phone": { "type": "string" },
        "isFarmer": { "type": "boolean" },
        "village": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "geminiApiKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" },
        "isBlocked": { "type": "boolean" },
        "isSuspended": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "AppContent": {
      "title": "AppContent",
      "description": "Global application content like banners and videos.",
      "type": "object",
      "properties": {
        "banners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "image": { "type": "string" },
              "title": { "type": "string" },
              "subtitle": { "type": "string" }
            }
          }
        },
        "videos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "videoId": { "type": "string" },
              "thumbnail": { "type": "string" }
            }
          }
        },
        "partners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "logo": { "type": "string" }
            }
          }
        },
        "whatsappSection": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "mode": { "type": "string", "enum": ["direct", "group"] },
            "groupLink": { "type": "string" }
          }
        },
        "contactInfo": {
          "type": "object",
          "properties": {
            "whatsapp": { "type": "string" },
            "address": { "type": "string" }
          }
        },
        "apiKeyGuideVideoUrl": { "type": "string" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Product categories.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "icon", "order"]
    },
    "AgriIssue": {
      "title": "AgriIssue",
      "description": "Encyclopedia of pests, diseases, and nutrient deficiencies.",
      "type": "object",
      "properties": {
        "hindiName": { "type": "string" },
        "englishName": { "type": "string" },
        "type": { "type": "string", "enum": ["pest", "disease", "deficiency"] },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "relatedProductIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["hindiName", "englishName", "type", "image"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notifications for users and admins.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["verification_request", "approval", "system"] },
        "targetUid": { "type": "string" },
        "senderUid": { "type": "string" },
        "metadata": { "type": "object" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "type", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of agricultural products."
    },
    "/cropAdvice/{adviceId}": {
      "schema": "CropAdvice",
      "description": "Collection of crop-wise advice."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and permissions."
    },
    "/settings/content": {
      "schema": "AppContent",
      "description": "Global application content settings."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of product categories."
    },
    "/agriIssues/{issueId}": {
      "schema": "AgriIssue",
      "description": "Collection of pests, diseases, and nutrient deficiencies."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System notifications."
    }
  }
}
