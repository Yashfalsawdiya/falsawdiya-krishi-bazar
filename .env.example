# Gemini API for Agricultural AI advice and market estimation
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Government Open Data API for Mandi Prices (data.gov.in AGMARKNET dataset)
DATA_GOV_IN_API_KEY=

# Firebase Configuration for Vercel
# Copy these values to Vercel Environment Variables
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Razorpay Configuration (Can also be managed directly via Admin Panel)
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gmail SMTP Email & Delivery OTP Configuration (Can also be managed directly via Admin Panel)
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=

# Optional: YouTube Data API v3 Key (Hybrid Video Hub works free without it via RSS; add key for full channel history & durations)
YOUTUBE_API_KEY=

# Automated Free Mandi Sync (GitHub Actions -> Vercel Mumbai)
# Set CRON_SYNC_SECRET in both Vercel Env Vars and GitHub Actions Secrets
CRON_SYNC_SECRET=
# Paste Firebase Service Account JSON (works on Spark Free plan via Firestore REST OAuth2 without Blaze/Credit Card)
FIREBASE_SERVICE_ACCOUNT_JSON=

